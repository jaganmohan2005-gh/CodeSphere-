# CodeSphere Environment Configuration Template
# Copy this file to .env and adjust variables as needed

# Flask App Settings
FLASK_ENV=development
SECRET_KEY=replace-with-a-very-long-random-secret-key-32-chars

# Database (Leave default for SQLite, or provide PostgreSQL URI)
# Example: postgresql://username:password@localhost:5432/codespheredb
DATABASE_URL=sqlite:///codesphere.db

# OpenAI API Configuration (Optional: CodeSphere includes full fallback tutor engine if left blank)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_RATE_LIMIT_PER_MINUTE=15

# Code Sandbox Execution
MAX_EXECUTION_TIME_SECONDS=4
MAX_CODE_LENGTH_CHARS=25000

# Default Seed Admin Account
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@codesphere.io
DEFAULT_ADMIN_PASSWORD=Admin@CodeSphere2026!
